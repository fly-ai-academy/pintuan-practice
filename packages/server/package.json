{
  "name": "@pintuan/server",
  "version": "0.1.0",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "predev": "pnpm --filter @pintuan/contracts build",
    "dev": "nest start --watch",
    "prebuild": "pnpm --filter @pintuan/contracts build",
    "build": "nest build",
    "start": "node dist/main.js",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src"
  },
  "dependencies": {
    "@nestjs/common": "12.1.2",
    "@nestjs/core": "12.1.2",
    "@nestjs/platform-express": "12.1.2",
    "@pintuan/contracts": "workspace:*",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "12.0.8",
    "@types/node": "22.20.5",
    "typescript": "5.9.3"
  }
}
